FME_PYTHON_VERSION 311
ARCGIS_COMPATIBILITY ARCGIS_AUTO
GUI IGNORE PATH_IN_FME_GROUP_NAMED1_PATH_4,PATH_IN_GLOB_PATTERN_PATH_4,PATH_IN_RECURSE_DIRECTORIES_PATH_4,PATH_IN_TYPE_PATH_4,PATH_IN_HIDDEN_FILES_PATH_4,SourceDataset_PATH_4,PATH_IN_NETWORK_AUTHENTICATION_PATH_4
# ============================================================================
DEFAULT_MACRO SourceDataset_PATH_6 N:\GI_SECTION\HPMS\Submissions

DEFAULT_MACRO DeleteChoice NO

DEFAULT_MACRO ChooseYearDeletion <Unused>

DEFAULT_MACRO YearSelection 2025_submission

DEFAULT_MACRO DataItemChoice cracking_percent,f_system,facility_type,faulting,iri,nhs,ownership,rutting,strahnet_type,urban_id

# ============================================================================
INCLUDE [ if {{$(SourceDataset_PATH_6$encode)} == {}} { puts_real {Parameter 'SourceDataset_PATH_6' must be given a value.}; exit 1; }; ]
INCLUDE [ if {{$(DeleteChoice$encode)} == {}} { puts_real {Parameter 'DeleteChoice' must be given a value.}; exit 1; }; ]
INCLUDE [ if {{$(DataItemChoice$encode)} == {}} { puts_real {Parameter 'DataItemChoice' must be given a value.}; exit 1; }; ]
#! START_HEADER
#! START_WB_HEADER
READER_TYPE MULTI_READER
MULTI_READER_TYPE{0} PATH
MULTI_READER_KEYWORD{0} PATH_4
MULTI_READER_GEN_DIRECTIVES{0} PATH_EXPOSE_FORMAT_ATTRS,,USE_NON_STRING_ATTR,yes,HIDDEN_FILES,INCLUDE,TYPE,ANY,NO_EMPTY_PROPERTIES,YES,OFFSET_DATETIME,yes,GLOB_PATTERN,*,RETRIEVE_FILE_PROPERTIES,NO,EXPOSE_ATTRS_GROUP,,_MERGE_SCHEMAS,YES,RECURSE_DIRECTORIES,YES
WRITER_TYPE MULTI_WRITER
WRITER_KEYWORD MULTI_DEST
MULTI_DEST_DATASET null
#! END_WB_HEADER
#! START_WB_HEADER
MACRO WB_KEYWORD "PATH_4"
#! END_WB_HEADER
#! START_SOURCE_HEADER PATH PATH_4
DEFAULT_MACRO PATH_IN_FME_GROUP_NAMED1_PATH_4 FME_DISCLOSURE_OPEN
GUI OPTIONAL DISCLOSUREGROUP PATH_IN_FME_GROUP_NAMED1_PATH_4 PATH_IN_GLOB_PATTERN_PATH_4%PATH_IN_RECURSE_DIRECTORIES_PATH_4%PATH_IN_TYPE_PATH_4%PATH_IN_HIDDEN_FILES_PATH_4%PATH_IN_RETRIEVE_FILE_PROPERTIES Path Parameters
# =============================================================================
DEFAULT_MACRO PATH_IN_OFFSET_DATETIME_PATH_4 yes
PATH_4_OFFSET_DATETIME "$(PATH_IN_OFFSET_DATETIME_PATH_4)"
# =============================================================================
DEFAULT_MACRO PATH_IN_USE_NON_STRING_ATTR_PATH_4 yes
PATH_4_USE_NON_STRING_ATTR "$(PATH_IN_USE_NON_STRING_ATTR_PATH_4)"
# =============================================================================
DEFAULT_MACRO PATH_IN_GLOB_PATTERN_PATH_4 *
PATH_4_GLOB_PATTERN "$(PATH_IN_GLOB_PATTERN_PATH_4)"
GUI OPTIONAL TEXT_ENCODED PATH_IN_GLOB_PATTERN_PATH_4 Path Filter:
# =============================================================================
DEFAULT_MACRO PATH_IN_RECURSE_DIRECTORIES_PATH_4 NO
PATH_4_RECURSE_DIRECTORIES "$(PATH_IN_RECURSE_DIRECTORIES_PATH_4)"
GUI CHOICE PATH_IN_RECURSE_DIRECTORIES_PATH_4 YES%NO Recurse Into Subfolders:
# =============================================================================
DEFAULT_MACRO PATH_IN_TYPE_PATH_4 ANY
PATH_4_TYPE "$(PATH_IN_TYPE_PATH_4)"
GUI LOOKUP_CHOICE PATH_IN_TYPE_PATH_4 Any,ANY%Directory,DIRECTORY%File,FILE Allowed Path Type:
# =============================================================================
DEFAULT_MACRO PATH_IN_HIDDEN_FILES_PATH_4 INCLUDE
PATH_4_HIDDEN_FILES "$(PATH_IN_HIDDEN_FILES_PATH_4)"
GUI LOOKUP_CHOICE PATH_IN_HIDDEN_FILES_PATH_4 Include,INCLUDE%Exclude,EXCLUDE Hidden Files and Folders:
# =============================================================================
DEFAULT_MACRO PATH_IN_RETRIEVE_FILE_PROPERTIES_PATH_4 NO
PATH_4_RETRIEVE_FILE_PROPERTIES "$(PATH_IN_RETRIEVE_FILE_PROPERTIES_PATH_4)"
# =============================================================================
DEFAULT_MACRO PATH_IN_NO_EMPTY_PROPERTIES_PATH_4 YES
PATH_4_NO_EMPTY_PROPERTIES "$(PATH_IN_NO_EMPTY_PROPERTIES_PATH_4)"
DEFAULT_MACRO PATH_IN_EXPOSE_ATTRS_GROUP_PATH_4 
PATH_4_EXPOSE_ATTRS_GROUP "$(PATH_IN_EXPOSE_ATTRS_GROUP_PATH_4)"
# =====================================================================
# The following GUI line prompts for the folder from which to
# read
# The dataset this mapping file was generated from was:
#! END_SOURCE_HEADER
#! START_WB_HEADER
DEFAULT_MACRO SourceDataset
INCLUDE [ if {{$(SourceDataset)} != ""} {                        \
 puts {DEFAULT_MACRO SourceDataset_PATH_4 $(SourceDataset)}     \
 } ]
#! END_WB_HEADER
#! START_SOURCE_HEADER PATH PATH_4
DEFAULT_MACRO SourceDataset_PATH_4 $(SourceDataset_PATH_6)
GUI MULTIDIR SourceDataset_PATH_4 Source Folder and File Pathnames Folder:
# ===========================================================================
DEFAULT_MACRO PATH_IN_NETWORK_AUTHENTICATION_PATH_4 
PATH_4_NETWORK_AUTHENTICATION "$(PATH_IN_NETWORK_AUTHENTICATION_PATH_4)"
GUI OPTIONAL AUTHENTICATOR PATH_IN_NETWORK_AUTHENTICATION_PATH_4 CONTAINER%GROUP%CONTAINER_TITLE%"Network Authentication"%PROMPT_TYPE%NETWORK Network Authentication
# ============================================================================
DEFAULT_MACRO PATH_IN_ATTRIBUTE_READING_PATH_4 ALL
PATH_4_ATTRIBUTE_READING "$(PATH_IN_ATTRIBUTE_READING_PATH_4)"
# ============================================================================
PATH_4_GENERATE_FME_BUILD_NUM 23783
PATH_4_DATASET "$(SourceDataset_PATH_4)"
#! END_SOURCE_HEADER
#! START_WB_HEADER
#! END_WB_HEADER
#! END_HEADER

LOG_FILENAME "$(FME_MF_DIR)csv_to_sql_migrator.log"
LOG_APPEND NO
LOG_TIMINGS YES
FME_DEBUG MAPPING_FILE BADNEWS UNGROUPED UNCORRELATED DUMP_SCHEMA XSD_VERBOSE HTTP_DEBUG FTP_DEBUG FME_DEBUG STASH
LOG_FILTER_MASK -1
LOG_MAX_FEATURES 200
LOG_MAX_RECORDED_FEATURES 200
FME_REPROJECTION_ENGINE FME
FME_IMPLICIT_CSMAP_REPROJECTION_MODE Auto
FME_GEOMETRY_HANDLING Enhanced
FME_STROKE_MAX_DEVIATION 0
FME_NAMES_ENCODING UTF-8
FME_BULK_MODE_THRESHOLD 2000
LAST_SAVE_BUILD "FME 2023.2.3.0 (20240313 - Build 23783 - WIN64)"
DEFAULT_MACRO DATASET_KEYWORD_PATH_4 PATH_4
# -------------------------------------------------------------------------

PATH_4_READER_META_ATTRIBUTES fme_feature_type

# -------------------------------------------------------------------------

MULTI_READER_CONTINUE_ON_READER_FAILURE No

# -------------------------------------------------------------------------

MACRO WORKSPACE_NAME csv_to_sql_migrator
MACRO FME_VIEWER_APP fmedatainspector
# -------------------------------------------------------------------------

FACTORY_DEF * RoutingFactory   FACTORY_NAME "Router and Unexpected Input Remover"   COMMAND_PARM_EVALUATION SINGLE_PASS   MULTI_READER_KEYWORD $(DATASET_KEYWORD_PATH_4)   INPUT FEATURE_TYPE *    ROUTE PATH PATH_4::PATH multi_reader_keyword,$(DATASET_KEYWORD_PATH_4) TO FME_GENERIC ::PATH ALIAS_GEOMETRY    MERGE_INPUT Yes   OUTPUT ROUTED FEATURE_TYPE *
PATH_4_MERGE_DEF PATH_4::PATH EXACT PATH
# -------------------------------------------------------------------------

FACTORY_DEF * TeeFactory    FACTORY_NAME "PATH_PATH_4 Splitter"    INPUT FEATURE_TYPE PATH    OUTPUT FEATURE_TYPE PATH_PATH_4
DEFAULT_MACRO WB_CURRENT_CONTEXT
# -------------------------------------------------------------------------
FACTORY_DEF {*} TeeFactory    FACTORY_NAME { TestFilter_16_INPUT }    INPUT  FEATURE_TYPE PATH_PATH_4    OUTPUT { FEATURE_TYPE TestFilter_16_INPUTLINE }
FACTORY_DEF {*} TestFactory FACTORY_NAME { TestFilter_16 } INPUT FEATURE_TYPE TestFilter_16_INPUTLINE FEATURE_TABLE_SHIM_SUPPORT Yes PRESERVE_FEATURE_ORDER PER_OUTPUT_PORT PASSED_TEST_GROUP_OUTPUT FIRST TEST_GROUP TEST { @EvaluateExpression(FDIV,STRING_ENCODED,$(DeleteChoice),TestFilter_16) = YES ENCODED } BOOLEAN_OPERATOR OR COMPOSITE_TEST_EXPR "1" OUTPUT PASSED_0 FEATURE_TYPE TestFilter_16___DeleteChoice_<space>=<space>Yes OUTPUT FAILED FEATURE_TYPE TestFilter_16_<lt>UNFILTERED<gt>
# -------------------------------------------------------------------------
FACTORY_DEF {*} TeeFactory    FACTORY_NAME { TestFilter_INPUT }    INPUT  FEATURE_TYPE TestFilter_16_<lt>UNFILTERED<gt>    OUTPUT { FEATURE_TYPE TestFilter_INPUTLINE }
FACTORY_DEF {*} TestFactory FACTORY_NAME { TestFilter } INPUT FEATURE_TYPE TestFilter_INPUTLINE FEATURE_TABLE_SHIM_SUPPORT Yes PRESERVE_FEATURE_ORDER PER_OUTPUT_PORT PASSED_TEST_GROUP_OUTPUT ALL TEST_GROUP CASE_INSENSITIVE_TEST { @EvaluateExpression(FDIV,STRING_ENCODED,<at>Value<openparen>path_rootname<closeparen>,TestFilter) IN @EvaluateExpression(FDIV,STRING_ENCODED,$(YearSelection$encode),TestFilter) ENCODED } BOOLEAN_OPERATOR OR COMPOSITE_TEST_EXPR "1" OUTPUT PASSED_0 FEATURE_TYPE TestFilter_<at>Value<openparen>path_rootname<closeparen><space>IN<space>__YearSelection_ OUTPUT FAILED FEATURE_TYPE TestFilter_<lt>UNFILTERED<gt>
FACTORY_DEF * TeeFactory   FACTORY_NAME "TestFilter <lt>UNFILTERED<gt> Transformer Output Nuker"   INPUT FEATURE_TYPE TestFilter_<lt>UNFILTERED<gt>
# -------------------------------------------------------------------------
MACRO FeatureReader_7_OUTPUT_PORTS_ENCODED 
MACRO FeatureReader_7_DIRECTIVES EXPOSE_ATTRS_GROUP,FME_DISCLOSURE_CLOSED,GLOB_PATTERN,*.csv,HIDDEN_FILES,INCLUDE,NETWORK_AUTHENTICATION,,NO_EMPTY_PROPERTIES,YES,OFFSET_DATETIME,yes,PATH_EXPOSE_FORMAT_ATTRS,,RECURSE_DIRECTORIES,YES,RETRIEVE_FILE_PROPERTIES,NO,TYPE,FILE,USE_NON_STRING_ATTR,yes
# Always provide an INTERACTION, otherwise the factory defaults to ENVELOPE_INTERSECTS
INCLUDE [if { ( {<Unused>} == {<Unused>} ) || ( {($INTERACT)} == {} ) } {             puts {MACRO FCTQUERY_INTERACTION_LINE FCTQUERY_INTERACTION NONE};          } else {             puts {MACRO FCTQUERY_INTERACTION_LINE FCTQUERY_INTERACTION "<Unused>"};          }         ]
# Consolidate the attribute merge options to what the factory expects
DEFAULT_MACRO FeatureReader_7_COMBINE_ATTRS
INCLUDE [       if { {RESULT_ONLY} == {MERGE} } {          puts "MACRO FeatureReader_7_COMBINE_ATTRS <Unused>";       } else {          puts "MACRO FeatureReader_7_COMBINE_ATTRS RESULT_ONLY";       };    ]
INCLUDE [    puts {DEFAULT_MACRO FeatureReaderDataset_FeatureReader_7 @EvaluateExpression(FDIV,STRING_ENCODED,<at>Value<openparen>path_windows<closeparen>,FeatureReader_7)}; ]
FACTORY_DEF {*} QueryFactory    FACTORY_NAME { FeatureReader_7 }    INPUT  FEATURE_TYPE TestFilter_<at>Value<openparen>path_rootname<closeparen><space>IN<space>__YearSelection_    INPUT  FEATURE_TYPE TestFilter_16___DeleteChoice_<space>=<space>Yes    $(FCTQUERY_INTERACTION_LINE)    COMBINE_ATTRIBUTES  { $(FeatureReader_7_COMBINE_ATTRS) }    IGNORE_NULLS        { <Unused> }    QUERYFCT_ATTRIBUTE_PREFIX { <Unused> }    COMBINE_GEOMETRY    { RESULT_ONLY }    ENABLE_CACHE        { NO }    QUERYFCT_TABLE_SEPARATOR { SPACE }    READER_TYPE         { PATH  }    READER_DATASET      { "$(FeatureReaderDataset_FeatureReader_7)" }    QUERYFCT_IDS        { "" }    READER_DIRECTIVES   { METAFILE,PATH }    QUERYFCT_OUTPUT     { "BASED_ON_CONNECTIONS" }    CONTINUE_ON_READER_ERROR YES    ORDER_RESULTS { "No" }    QUERYFCT_RESULT_TAGS { $(FeatureReader_7_OUTPUT_PORTS_ENCODED) }    QUERYFCT_SET_FME_FEATURE_TYPE YES    READER_PARAMS_WWJD     { $(FeatureReader_7_DIRECTIVES) }    TREAT_READER_PARAM_AMPERSANDS_AS_LITERALS YES    OUTPUT { QUERY FEATURE_TYPE FeatureReader_7_INITIATOR           }    OUTPUT { READER_ERROR FEATURE_TYPE FeatureReader_7_<REJECTED>           }
DEFAULT_MACRO _WB_BYPASS_TERMINATION No
FACTORY_DEF * TeeFactory FACTORY_NAME FeatureReader_7_<Rejected> INPUT FEATURE_TYPE FeatureReader_7_<REJECTED>  NO_LOGGING   OUTPUT FAILED FEATURE_TYPE * @Abort(ENCODED, FeatureReader_7<space>output<space>a<space><lt>Rejected<gt><space>feature.<space><space>To<space>continue<space>translation<space>when<space>features<space>are<space>rejected<comma><space>change<space><apos>Workspace<space>Parameters<apos><space><gt><space>Translation<space><gt><space><apos>Rejected<space>Feature<space>Handling<apos><space>to<space><apos>Continue<space>Translation<apos>)
# -------------------------------------------------------------------------
