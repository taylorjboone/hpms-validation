MACRO SQLExecutor_DIRECTIVES APPLICATION_INTENT ReadWrite COMMAND_TIMEOUT 30 CREATE_FEATURE_TABLES_FROM_DATA Yes NAMED_CONNECTION HPMS QUERY_FEATURE_TYPES_FOR_MERGE_FILTERS Yes
FACTORY_DEF {*} QueryFactory    FACTORY_NAME { SQLExecutor }    INPUT  FEATURE_TYPE TestFilter_17_<lt>UNFILTERED<gt>    QUERY_SQL            { "@EvaluateExpression(FDIV,STRING_ENCODED,DELETE<space>from<space><at>Value<openparen>DataItem<closeparen><space>WHERE<space>DataYear<space>IN<space><openparen>$(ChooseYearDeletion$encode)<closeparen>,SQLExecutor)" }    READER_TYPE          { MSSQL_ADO }    READER_DATASET       { "HPMS" }    COMBINE_ATTRIBUTES   { RESULT_ONLY }    IGNORE_NULLS         { <Unused> }    COMBINE_GEOMETRY     { QUERY_ONLY }    QUERYFCT_OUTPUT      { "BASED_ON_CONNECTIONS" }    CONTINUE_ON_READER_ERROR YES    QUERYFCT_PROPAGATE_IDS_ON_SQL_EXECUTE YES    READER_PARAMS        { $(SQLExecutor_DIRECTIVES) }    OUTPUT { READER_ERROR FEATURE_TYPE SQLExecutor_<REJECTED>         }
DEFAULT_MACRO _WB_BYPASS_TERMINATION No
FACTORY_DEF * TeeFactory FACTORY_NAME SQLExecutor_<Rejected> INPUT FEATURE_TYPE SQLExecutor_<REJECTED>  NO_LOGGING   OUTPUT FAILED FEATURE_TYPE * @Abort(ENCODED, SQLExecutor<space>output<space>a<space><lt>Rejected<gt><space>feature.<space><space>To<space>continue<space>translation<space>when<space>features<space>are<space>rejected<comma><space>change<space><apos>Workspace<space>Parameters<apos><space><gt><space>Translation<space><gt><space><apos>Rejected<space>Feature<space>Handling<apos><space>to<space><apos>Continue<space>Translation<apos>)
