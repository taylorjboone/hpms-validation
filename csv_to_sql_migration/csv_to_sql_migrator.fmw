FACTORY_DEF {*} TestFactory FACTORY_NAME { TestFilter_13 } INPUT FEATURE_TYPE TestFilter_13_INPUTLINE FEATURE_TABLE_SHIM_SUPPORT Yes PRESERVE_FEATURE_ORDER PER_OUTPUT_PORT PASSED_TEST_GROUP_OUTPUT FIRST TEST_GROUP CASE_INSENSITIVE_TEST { @EvaluateExpression(FDIV,STRING_ENCODED,<at>Value<openparen>DataItem<closeparen>,TestFilter_13) CONTAINS alternative ENCODED } BOOLEAN_OPERATOR OR COMPOSITE_TEST_EXPR "1" OUTPUT PASSED_0 FEATURE_TYPE TestFilter_13_<at>Value<openparen>DataItem<closeparen><space>CONTAINS<space>alternative TEST_GROUP CASE_INSENSITIVE_TEST { @EvaluateExpression(FDIV,STRING_ENCODED,<at>Value<openparen>DataItem<closeparen>,TestFilter_13) CONTAINS flexible ENCODED } BOOLEAN_OPERATOR OR COMPOSITE_TEST_EXPR "1" OUTPUT PASSED_1 FEATURE_TYPE TestFilter_13_<at>Value<openparen>DataItem<closeparen><space>CONTAINS<space>flexible TEST_GROUP CASE_INSENSITIVE_TEST { @EvaluateExpression(FDIV,STRING_ENCODED,<at>Value<openparen>DataItem<closeparen>,TestFilter_13) CONTAINS urban ENCODED } BOOLEAN_OPERATOR OR COMPOSITE_TEST_EXPR "1" OUTPUT PASSED_2 FEATURE_TYPE TestFilter_13_<at>Value<openparen>DataItem<closeparen><space>CONTAINS<space>urban TEST_GROUP CASE_INSENSITIVE_TEST { @EvaluateExpression(FDIV,STRING_ENCODED,<at>Value<openparen>DataItem<closeparen>,TestFilter_13) CONTAINS pct_peak_single ENCODED } BOOLEAN_OPERATOR OR COMPOSITE_TEST_EXPR "1" OUTPUT PASSED_3 FEATURE_TYPE TestFilter_13_<at>Value<openparen>DataItem<closeparen><space>CONTAINS<space>pct_peak_single TEST_GROUP CASE_INSENSITIVE_TEST { @EvaluateExpression(FDIV,STRING_ENCODED,<at>Value<openparen>DataItem<closeparen>,TestFilter_13) CONTAINS pct_peak_combination ENCODED } BOOLEAN_OPERATOR OR COMPOSITE_TEST_EXPR "1" OUTPUT PASSED_4 FEATURE_TYPE TestFilter_13_<at>Value<openparen>DataItem<closeparen><space>CONTAINS<space>pct_peak_combination TEST_GROUP CASE_INSENSITIVE_TEST { @EvaluateExpression(FDIV,STRING_ENCODED,<at>Value<openparen>DataItem<closeparen>,TestFilter_13) CONTAINS truck ENCODED } BOOLEAN_OPERATOR OR COMPOSITE_TEST_EXPR "1" OUTPUT PASSED_5 FEATURE_TYPE TestFilter_13_truck<space>CONTAINS<space>truck TEST_GROUP CASE_INSENSITIVE_TEST { @EvaluateExpression(FDIV,STRING_ENCODED,<at>Value<openparen>DataItem<closeparen>,TestFilter_13) CONTAINS pct_dh_single_unit ENCODED } BOOLEAN_OPERATOR OR COMPOSITE_TEST_EXPR "1" OUTPUT PASSED_6 FEATURE_TYPE TestFilter_13_<at>Value<openparen>DataItem<closeparen><space>CONTAINS<space>pct_dh_single_unit TEST_GROUP TEST { DataItem ATTRIBUTE_IS_MISSING "" ENCODED } BOOLEAN_OPERATOR OR COMPOSITE_TEST_EXPR "1" OUTPUT PASSED_7 FEATURE_TYPE TestFilter_13_DataItem<space>ATTRIBUTE_IS_MISSING TEST_GROUP TEST { DataItem ATTRIBUTE_IS_EMPTY "" ENCODED } BOOLEAN_OPERATOR OR COMPOSITE_TEST_EXPR "1" OUTPUT PASSED_8 FEATURE_TYPE TestFilter_13_DataItem<space>ATTRIBUTE_IS_EMPTY TEST_GROUP TEST { DataItem ATTRIBUTE_VALUE_NULL "" ENCODED } BOOLEAN_OPERATOR OR COMPOSITE_TEST_EXPR "1" OUTPUT PASSED_9 FEATURE_TYPE TestFilter_13_DataItem<space>ATTRIBUTE_VALUE_NULL OUTPUT FAILED FEATURE_TYPE TestFilter_13_<lt>UNFILTERED<gt>
