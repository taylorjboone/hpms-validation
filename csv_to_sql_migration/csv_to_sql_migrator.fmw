FACTORY_DEF {*} TestFactory FACTORY_NAME { TestFilter_11 } INPUT FEATURE_TYPE TestFilter_11_INPUTLINE FEATURE_TABLE_SHIM_SUPPORT Yes PRESERVE_FEATURE_ORDER PER_OUTPUT_PORT PASSED_TEST_GROUP_OUTPUT FIRST TEST_GROUP CASE_INSENSITIVE_TEST { @EvaluateExpression(FDIV,STRING_ENCODED,<at>Value<openparen>DataItem<closeparen>,TestFilter_11) CONTAINS curve ENCODED } BOOLEAN_OPERATOR OR COMPOSITE_TEST_EXPR "1" OUTPUT PASSED_0 FEATURE_TYPE TestFilter_11_<at>Value<openparen>DataItem<closeparen><space>CONTAINS<space>curve TEST_GROUP CASE_INSENSITIVE_TEST { @EvaluateExpression(FDIV,STRING_ENCODED,<at>Value<openparen>DataItem<closeparen>,TestFilter_11) IN grades_a<comma>grades_b<comma>grades_c<comma>grades_d<comma>grades_e<comma>grades_f ENCODED } BOOLEAN_OPERATOR OR COMPOSITE_TEST_EXPR "1" OUTPUT PASSED_1 FEATURE_TYPE TestFilter_11_<at>Value<openparen>DataItem<closeparen><space>IN<space>grades_a<comma>grades_b<comma>grades_c<comma>grades_d<comma>grades_e<comma>grades_f TEST_GROUP CASE_INSENSITIVE_TEST { @EvaluateExpression(FDIV,STRING_ENCODED,<at>Value<openparen>DataItem<closeparen>,TestFilter_11) CONTAINS alternative ENCODED } BOOLEAN_OPERATOR OR COMPOSITE_TEST_EXPR "1" OUTPUT PASSED_2 FEATURE_TYPE TestFilter_11_<at>Value<openparen>DataItem<closeparen><space>CONTAINS<space>alternative TEST_GROUP CASE_INSENSITIVE_TEST { @EvaluateExpression(FDIV,STRING_ENCODED,<at>Value<openparen>DataItem<closeparen>,TestFilter_11) CONTAINS flexible ENCODED } BOOLEAN_OPERATOR OR COMPOSITE_TEST_EXPR "1" OUTPUT PASSED_3 FEATURE_TYPE TestFilter_11_<at>Value<openparen>DataItem<closeparen><space>CONTAINS<space>flexible TEST_GROUP CASE_INSENSITIVE_TEST { @EvaluateExpression(FDIV,STRING_ENCODED,<at>Value<openparen>DataItem<closeparen>,TestFilter_11) CONTAINS urban ENCODED } BOOLEAN_OPERATOR OR COMPOSITE_TEST_EXPR "1" OUTPUT PASSED_4 FEATURE_TYPE TestFilter_11_<at>Value<openparen>DataItem<closeparen><space>CONTAINS<space>urban TEST_GROUP CASE_INSENSITIVE_TEST { @EvaluateExpression(FDIV,STRING_ENCODED,<at>Value<openparen>DataItem<closeparen>,TestFilter_11) CONTAINS pct_peak_single ENCODED } BOOLEAN_OPERATOR OR COMPOSITE_TEST_EXPR "1" OUTPUT PASSED_5 FEATURE_TYPE TestFilter_11_<at>Value<openparen>DataItem<closeparen><space>CONTAINS<space>pct_peak_single TEST_GROUP CASE_INSENSITIVE_TEST { @EvaluateExpression(FDIV,STRING_ENCODED,<at>Value<openparen>DataItem<closeparen>,TestFilter_11) CONTAINS pct_peak_combination ENCODED } BOOLEAN_OPERATOR OR COMPOSITE_TEST_EXPR "1" OUTPUT PASSED_6 FEATURE_TYPE TestFilter_11_<at>Value<openparen>DataItem<closeparen><space>CONTAINS<space>pct_peak_combination TEST_GROUP CASE_INSENSITIVE_TEST { @EvaluateExpression(FDIV,STRING_ENCODED,<at>Value<openparen>DataItem<closeparen>,TestFilter_11) CONTAINS truck ENCODED } BOOLEAN_OPERATOR OR COMPOSITE_TEST_EXPR "1" OUTPUT PASSED_7 FEATURE_TYPE TestFilter_11_truck<space>CONTAINS<space>truck TEST_GROUP CASE_INSENSITIVE_TEST { @EvaluateExpression(FDIV,STRING_ENCODED,<at>Value<openparen>DataItem<closeparen>,TestFilter_11) CONTAINS pct_dh_single_unit ENCODED } BOOLEAN_OPERATOR OR COMPOSITE_TEST_EXPR "1" OUTPUT PASSED_8 FEATURE_TYPE TestFilter_11_<at>Value<openparen>DataItem<closeparen><space>CONTAINS<space>pct_dh_single_unit OUTPUT FAILED FEATURE_TYPE TestFilter_11_<lt>UNFILTERED<gt>
# -------------------------------------------------------------------------
# Since the Tcl "END" index specification starts at -1 for the second
# last character, and we've defined -1 to be the last charater, we've got
# small bit of fiddling to do
Tcl2 proc SubstringExtractor_fixLastIndex {lastValue} {     if {$lastValue < -1} {         incr lastValue;         return "end$lastValue";     }     elseif {$lastValue == -1} {         return "end";     }     else {         return $lastValue;     } }
Tcl2 proc SubstringExtractor_extract {startIdx endIdx} {     FME_SetAttribute [FME_DecodeText DataItem]         [string range [FME_DecodeTextOrAttr @EvaluateExpression(FDIV,STRING_ENCODED,<at>Value<openparen>DataItem<closeparen>,SubstringExtractor)]                       [SubstringExtractor_fixLastIndex $startIdx]                       [SubstringExtractor_fixLastIndex $endIdx]]     }
FACTORY_DEF {*} TeeFactory    FACTORY_NAME { SubstringExtractor }    INPUT  FEATURE_TYPE TestFilter_11_<at>Value<openparen>DataItem<closeparen><space>CONTAINS<space>curve    OUTPUT { FEATURE_TYPE SubstringExtractor_OUTPUT         @Tcl2("SubstringExtractor_extract 0 5")          }
# -------------------------------------------------------------------------
# Since the Tcl "END" index specification starts at -1 for the second
# last character, and we've defined -1 to be the last charater, we've got
# small bit of fiddling to do
Tcl2 proc SubstringExtractor_2_fixLastIndex {lastValue} {     if {$lastValue < -1} {         incr lastValue;         return "end$lastValue";     }     elseif {$lastValue == -1} {         return "end";     }     else {         return $lastValue;     } }
Tcl2 proc SubstringExtractor_2_extract {startIdx endIdx} {     FME_SetAttribute [FME_DecodeText DataItem]         [string range [FME_DecodeTextOrAttr @EvaluateExpression(FDIV,STRING_ENCODED,<at>Value<openparen>DataItem<closeparen>,SubstringExtractor_2)]                       [SubstringExtractor_2_fixLastIndex $startIdx]                       [SubstringExtractor_2_fixLastIndex $endIdx]]     }
FACTORY_DEF {*} TeeFactory    FACTORY_NAME { SubstringExtractor_2 }    INPUT  FEATURE_TYPE TestFilter_11_<at>Value<openparen>DataItem<closeparen><space>IN<space>grades_a<comma>grades_b<comma>grades_c<comma>grades_d<comma>grades_e<comma>grades_f    OUTPUT { FEATURE_TYPE SubstringExtractor_2_OUTPUT         @Tcl2("SubstringExtractor_2_extract 0 5")          }
