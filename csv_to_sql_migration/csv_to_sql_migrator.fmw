"1" OUTPUT PASSED_5 FEATURE_TYPE TestFilter_6_<at>Value<openparen>path_windows<closeparen><space>CONTAINS<space>sample TEST_GROUP CASE_INSENSITIVE_TEST { @EvaluateExpression(FDIV,STRING_ENCODED,<at>Value<openparen>path_windows<closeparen>,TestFilter_6) CONTAINS validation ENCODED } BOOLEAN_OPERATOR OR COMPOSITE_TEST_EXPR "1" OUTPUT PASSED_6 FEATURE_TYPE TestFilter_6_<at>Value<openparen>path_windows<closeparen><space>CONTAINS<space>validation TEST_GROUP CASE_INSENSITIVE_TEST { @EvaluateExpression(FDIV,STRING_ENCODED,<at>Value<openparen>path_windows<closeparen>,TestFilter_6) CONTAINS combined ENCODED } BOOLEAN_OPERATOR OR COMPOSITE_TEST_EXPR "1" OUTPUT PASSED_7 FEATURE_TYPE TestFilter_6_<at>Value<openparen>path_windows<closeparen><space>CONTAINS<space>combined TEST_GROUP CASE_INSENSITIVE_TEST { @EvaluateExpression(FDIV,STRING_ENCODED,<at>Value<openparen>path_windows<closeparen>,TestFilter_6) CONTAINS ttm ENCODED } BOOLEAN_OPERATOR OR COMPOSITE_TEST_EXPR "1" OUTPUT PASSED_8 FEATURE_TYPE TestFilter_6_<at>Value<openparen>path_windows<closeparen><space>CONTAINS<space>ttm OUTPUT FAILED FEATURE_TYPE TestFilter_6_<lt>UNFILTERED<gt>
